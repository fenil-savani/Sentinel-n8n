# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in.  Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=n8n                    # n8n's own DB; sentinel DB is created by db/init.sql

# ── n8n ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-32-byte-hex
N8N_HOST=<ip>
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://<ip>:5678/
GENERIC_TIMEZONE=Asia/Kolkata
# Allows the UI to be reached by IP/hostname over plain HTTP (not just
# "localhost"), which browsers otherwise refuse to attach the secure
# auth cookie to. Fine on a trusted internal network; set up TLS instead
# if this box is reachable beyond that.
N8N_SECURE_COOKIE=false

# ── LLM ───────────────────────────────────────────────────────
# One model per flow, sized to that flow's task complexity. Each is
# independently overridable — tune or swap one without affecting the others.
# All default to Haiku 4.5; raise a flow back to Sonnet/Opus here if its
# generation quality needs it.

# Parser generation: one shot, reasoning-heavy (schema derivation, KQL).
# Also used by Analytic Rule and TDD generation (see app/generators/).
LLM_MODEL_PARSER=claude-haiku-4-5-20251001

# Workbook manifest planning: reasoning-heavy (decides panels/groups/tabs).
LLM_MODEL_WORKBOOK_MANIFEST=claude-haiku-4-5-20251001

# Per-panel loop: called once per panel (up to 100+ per workbook), so a
# smaller/cheaper model here matters a lot more than for the two above.
LLM_MODEL_PANEL=claude-haiku-4-5-20251001

# Model behind /v1/chat/completions — the OpenAI-compatible proxy n8n's own
# orchestrator chat node talks to (see app/llm/openai_compat.py). Always
# runs via the claude CLI, independent of LLM_PROVIDER below.
ORCHESTRATOR_MODEL=claude-haiku-4-5-20251001

# "anthropic" (default): calls the Anthropic API directly, billed per-token
#   against ANTHROPIC_API_KEY below.
# "claude_cli": shells out to a local `claude` CLI binary instead, using a
#   Claude Code subscription (no API key) — see the block below and
#   services/sentinel-agent/app/llm/claude_cli.py. Trade-off: generation
#   loses the model's own live run_kql/run_python self-check tools; the same
#   post-generation lint + KQL validation still gates every draft either
#   way. Subscription rate limits are a rolling 5-hour window, not
#   per-token, so a high PANEL_CONCURRENCY can hit them sooner than the API
#   would.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

# ── Claude CLI (only used when LLM_PROVIDER=claude_cli) ─────────
# One-time, on a machine already logged in via `claude` (browser/OAuth):
#   claude setup-token
# Paste the result here. This runtime strips ANTHROPIC_API_KEY from the
# CLI's subprocess environment regardless, so it can't silently fall back to
# key-based billing if both happen to be set.
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the `claude` binary. Leave blank to resolve it from PATH (the
# Dockerfile installs it via npm by default).
CLAUDE_CLI_BIN=

# Seconds before a single claude CLI generation call is killed.
CLAUDE_CLI_TIMEOUT=600

# ── Azure: management plane (deploy) ────────────────────────
# Service principal with Log Analytics Contributor + Monitoring Contributor
# on the resource group.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Log Analytics workspace ─────────────────────────────────
AZURE_WORKSPACE_NAME=
# The workspace *customer id* (GUID shown as "Workspace ID" in the portal),
# NOT the ARM resource id. Used by the data-plane query API.
AZURE_WORKSPACE_ID=

# ── Azure: data plane (KQL validation) ──────────────────────
# Separate READ-ONLY service principal: Log Analytics Reader on the workspace.
# Falls back to AZURE_CLIENT_ID/SECRET above if left blank.
AZURE_LOGS_CLIENT_ID=
AZURE_LOGS_CLIENT_SECRET=

# ── Sidecar behaviour ───────────────────────────────────────
# Run every generated panel query before assembly. Off by default: it costs
# one Log Analytics round trip per panel. Flip to true for high assurance.
VALIDATE_PANEL_QUERIES=false

# Concurrent per-panel generation calls.
PANEL_CONCURRENCY=4

# Retries per panel before it is marked failed and the run continues.
PANEL_MAX_RETRIES=3

# Seconds before run_python is killed.
PYTHON_EXEC_TIMEOUT=30

LOG_LEVEL=INFO
