{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowExtraction",
  "description": "Strict JSON contract the LLM extractor MUST return. Consumed by assembler.py to render project.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pattern", "confidence", "steps", "passthrough_fields", "notes"],
  "properties": {
    "pattern": {
      "enum": ["A", "B", "C", "unknown"],
      "description": "A = single agent run once. B = pipeline-level loop with feedback. C = per-step independent retries."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "max_iterations": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Pattern B only. Null for A and C."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agent", "confidence"],
        "properties": {
          "id":         { "type": "string", "minLength": 1 },
          "agent":      { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "max_retries": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Pattern C only. Per-step retry limit."
          },
          "exit_condition": {
            "type": ["object", "null"],
            "description": "Pattern C only. Null for B (pipeline-level) and A.",
            "additionalProperties": false,
            "required": ["field", "equals"],
            "properties": {
              "field":  { "type": "string" },
              "equals": {}
            }
          },
          "feedback_field": {
            "type": ["string", "null"],
            "description": "Pattern C only. Field name in this step's output that carries retry feedback."
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "pipeline_exit_condition": {
      "type": ["object", "null"],
      "description": "Pattern B only.",
      "additionalProperties": false,
      "required": ["step", "field", "equals"],
      "properties": {
        "step":   { "type": "string" },
        "field":  { "type": "string" },
        "equals": {}
      }
    },
    "pipeline_feedback": {
      "type": ["object", "null"],
      "description": "Pattern B only. How reviewer feedback flows back into the generator step.",
      "additionalProperties": false,
      "required": ["from_step", "from_field", "to_step", "as"],
      "properties": {
        "from_step":  { "type": "string" },
        "from_field": { "type": "string" },
        "to_step":    { "type": "string" },
        "as":         { "type": "string", "default": "ctx_feedback" },
        "fallback":   { "type": ["string", "null"] }
      }
    },
    "passthrough_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "passthrough_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.0
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form notes about assumptions, ambiguity, or fields the LLM could not resolve."
    }
  }
}
