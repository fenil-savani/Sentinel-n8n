  "summary": "Counts failed Windows login attempts per source IP over a 1-hour sliding window and alerts when the count exceeds 10, grouped by source IP address.",
  "intent": "Detect brute-force login attacks against Windows hosts by identifying source IPs generating an unusually high number of authentication failures.",
  "use_case": "Brute Force Detection -- Windows Authentication",
  "parsed_json": {
    "base_search": {
      "index": "wineventlog",
      "criteria": [
        {
          "field": "EventCode",
          "operator": "=",
          "value": "4625"
        },
        {
          "field": "sourcetype",
          "operator": "=",
          "value": "WinEventLog:Security"
        }
      ]
    },
    "pipeline": [
      {
        "command": "stats",
        "arguments": {
          "function": "count",
          "by": [
            "src_ip"
          ]
        }
      },
      {
        "command": "where",
        "arguments": {
          "condition": "count > 10"
        }
      }
    ],
    "time_window": {
      "type": "sliding",
      "value": 1,
      "unit": "hours"
    }
  },
  "commands": [
    {
      "name": "search",
      "description": "Base event filter by EventCode and sourcetype"
    },
    {
      "name": "stats",
      "description": "Count events grouped by src_ip"
    },
    {
      "name": "where",
      "description": "Filter groups where count exceeds threshold"
    }
  ],
  "fields": [
    "EventCode",
    "sourcetype",
    "src_ip"
  ],
  "functions": [
    "count"
  ],
  "field_mappings": [
